# Database Configuration
# Example for Neon PostgreSQL: postgresql://username:password@host:5432/database
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/database?sslmode=require

# JWT Secret (MUST be the same as frontend BETTER_AUTH_SECRET)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=your_generated_secret_here_must_match_frontend

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001,https://your-frontend-domain.vercel.app

# Environment
ENVIRONMENT=development

# OpenAI API Configuration (Phase III)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
